# Copy to .env and set these test-only values. Never commit .env.
BASE_URL=http://localhost:9080/kitchensink
MONGODB_URI=mongodb://localhost:27017/kitchensink
AUTH0_ISSUER_URI=https://YOUR_AUTH0_DOMAIN/
AUTH0_CLIENT_ID=YOUR_TEST_APPLICATION_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_TEST_APPLICATION_CLIENT_SECRET
AUTH0_AUDIENCE=YOUR_AUTH0_API_IDENTIFIER
AUTH0_CONNECTION=Username-Password-Authentication
# Auth0 user/password credentials generated by generate-users.
AUTH0_USERS_FILE=users/credentials.json
# Optional API scopes
AUTH0_SCOPE=
# Sustained-load profile (applies to each scenario repetition)
LOAD_RAMP_SECONDS=30
LOAD_WARMUP_SECONDS=30
LOAD_MEASURE_SECONDS=180
LOAD_REPETITIONS=3
