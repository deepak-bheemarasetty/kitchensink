# Local Spring Boot application configuration. Never commit .env.
# Local unauthenticated development default. Replace with the service account URI for protected MongoDB:
MONGODB_URI=mongodb://localhost:27017/kitchensink
# Authenticated example: mongodb://kitchensink_app:REPLACE_WITH_SECRET@localhost:27017/kitchensink?authSource=kitchensink
OIDC_ISSUER_URI=https://YOUR_AUTH0_DOMAIN/
OIDC_CLIENT_ID=YOUR_REGULAR_WEB_APP_CLIENT_ID
OIDC_CLIENT_SECRET=YOUR_REGULAR_WEB_APP_CLIENT_SECRET
OIDC_AUDIENCE=YOUR_AUTH0_API_IDENTIFIER
# Comma-separated initial administrator email addresses to seed on startup:
ADMIN_EMAILS=
LOG_LEVEL=INFO
